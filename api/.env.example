# PostgreSQL connection URL
DATABASE_URL=postgres://bams_user:securepass@localhost:5432/bams

# JWT configuration
JWT_SECRET=super_secure_jwt_secret_here
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# AES-256 encryption key for biometric templates
ENCRYPTION_KEY=replace_with_32_byte_base64_or_raw_secret

# AWS S3 configuration for reports and logs
S3_BUCKET=bams-reports
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY

# Frontend allowed origin for CORS
FRONTEND_URL=http://localhost:8000

# Server configuration
PORT=4000
